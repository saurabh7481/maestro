{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Maestro",
  "version": "0.9.0",
  "identifier": "dev.maestro.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Maestro",
        "width": 1280,
        "height": 800,
        "minWidth": 860,
        "minHeight": 560,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["maestro"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg0QjBFMERDODUyMDlGRkIKUldUN255Q0YzT0N3aE85eGh6UTdSZmJoK1VxOUFOanV4bXRsNGlkRHNORjdIeWZtSDQ4YVRQNUQK",
      "endpoints": ["https://github.com/saurabh7481/maestro/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": {
      "../mobile/dist": "mobile"
    },
    "icon": [
      "icons/256x256.png",
      "icons/128x128@2x.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
